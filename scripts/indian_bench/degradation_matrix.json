{
  "version": "1.0",
  "units": "all sizes are pixels of the clean reference (long side 800 px; a frontal face chip is about 200 px wide)",
  "severity": "level 1 = mild, 2 = moderate, 3 = strong, 4 = severe. Types with fewer levels list only the ones they have.",
  "variant_id": "<sample_id>__<type>__L<level>",
  "note": "`order` is the exact order of operations; `levels` holds the operator list applied left to right (scripts/indian_bench/degradations.py). To shrink or grow the benchmark edit `tier` here or `matrix_tiers` in config.json; nothing is dropped silently.",
  "types": [
    {"type": "gaussian_blur", "category": "blur", "tier": "core", "order": "Gaussian blur",
     "description": "isotropic Gaussian blur (generic softness / slight misfocus)",
     "levels": {"1": [{"op": "gaussian_blur", "sigma": 0.8}], "2": [{"op": "gaussian_blur", "sigma": 1.5}],
                "3": [{"op": "gaussian_blur", "sigma": 2.5}], "4": [{"op": "gaussian_blur", "sigma": 4.0}]}},

    {"type": "motion_blur_000", "category": "blur", "tier": "core", "order": "Motion blur (horizontal)",
     "description": "linear motion blur, 0 degrees (horizontal subject / camera movement)",
     "levels": {"1": [{"op": "motion_blur", "length": 5, "angle": 0}], "2": [{"op": "motion_blur", "length": 9, "angle": 0}],
                "3": [{"op": "motion_blur", "length": 15, "angle": 0}], "4": [{"op": "motion_blur", "length": 23, "angle": 0}]}},
    {"type": "motion_blur_045", "category": "blur", "tier": "core", "order": "Motion blur (diagonal)",
     "description": "linear motion blur, 45 degrees",
     "levels": {"1": [{"op": "motion_blur", "length": 5, "angle": 45}], "2": [{"op": "motion_blur", "length": 9, "angle": 45}],
                "3": [{"op": "motion_blur", "length": 15, "angle": 45}], "4": [{"op": "motion_blur", "length": 23, "angle": 45}]}},
    {"type": "motion_blur_090", "category": "blur", "tier": "core", "order": "Motion blur (vertical)",
     "description": "linear motion blur, 90 degrees (vertical movement, e.g. a nod)",
     "levels": {"1": [{"op": "motion_blur", "length": 5, "angle": 90}], "2": [{"op": "motion_blur", "length": 9, "angle": 90}],
                "3": [{"op": "motion_blur", "length": 15, "angle": 90}], "4": [{"op": "motion_blur", "length": 23, "angle": 90}]}},

    {"type": "defocus_blur", "category": "blur", "tier": "core", "order": "Defocus (disk) blur",
     "description": "out-of-focus lens: uniform disk point-spread function",
     "levels": {"1": [{"op": "defocus_blur", "radius": 1.5}], "2": [{"op": "defocus_blur", "radius": 2.5}],
                "3": [{"op": "defocus_blur", "radius": 4.0}], "4": [{"op": "defocus_blur", "radius": 6.0}]}},

    {"type": "box_blur", "category": "blur", "tier": "core", "order": "Box blur",
     "description": "box / average filter (cheap software smoothing)",
     "levels": {"1": [{"op": "box_blur", "ksize": 3}], "2": [{"op": "box_blur", "ksize": 5}],
                "3": [{"op": "box_blur", "ksize": 9}], "4": [{"op": "box_blur", "ksize": 13}]}},

    {"type": "down_up", "category": "blur", "tier": "core", "order": "Downsample (area) -> Upsample (bicubic)",
     "description": "reduced resolution then upscaling back to the reference size: detail lost to a low-resolution capture. Covers both 'downsample-then-upsample blur' and 'reduced resolution followed by upscaling'",
     "levels": {"1": [{"op": "resize_down", "factor": 1.5, "interp": "area"}, {"op": "resize_up", "interp": "bicubic"}],
                "2": [{"op": "resize_down", "factor": 2.0, "interp": "area"}, {"op": "resize_up", "interp": "bicubic"}],
                "3": [{"op": "resize_down", "factor": 3.0, "interp": "area"}, {"op": "resize_up", "interp": "bicubic"}],
                "4": [{"op": "resize_down", "factor": 4.0, "interp": "area"}, {"op": "resize_up", "interp": "bicubic"}]}},

    {"type": "resample", "category": "blur", "tier": "core", "order": "Downsample (no anti-aliasing) -> Upsample (naive interpolation)",
     "description": "resampling / interpolation degradation: careless resizing that aliases and then interpolates (level 4 = visible pixel blocks)",
     "levels": {"1": [{"op": "resize_down", "factor": 1.5, "interp": "bilinear"}, {"op": "resize_up", "interp": "bilinear"}],
                "2": [{"op": "resize_down", "factor": 2.0, "interp": "nearest"}, {"op": "resize_up", "interp": "bilinear"}],
                "3": [{"op": "resize_down", "factor": 3.0, "interp": "nearest"}, {"op": "resize_up", "interp": "bilinear"}],
                "4": [{"op": "resize_down", "factor": 4.0, "interp": "nearest"}, {"op": "resize_up", "interp": "nearest"}]}},

    {"type": "camera_shake", "category": "blur", "tier": "core", "order": "Camera-shake blur (random curved path)",
     "description": "hand-shake: blur along a smooth random trajectory, different for every image (seeded)",
     "levels": {"1": [{"op": "shake_blur", "extent": 5}], "2": [{"op": "shake_blur", "extent": 9}],
                "3": [{"op": "shake_blur", "extent": 13}], "4": [{"op": "shake_blur", "extent": 19}]}},

    {"type": "defocus_motion", "category": "blur_combined", "tier": "core", "order": "Defocus blur -> Motion blur",
     "description": "combined blur: slightly out of focus and moving",
     "levels": {"1": [{"op": "defocus_blur", "radius": 1.2}, {"op": "motion_blur", "length": 5, "angle": 30}],
                "2": [{"op": "defocus_blur", "radius": 2.0}, {"op": "motion_blur", "length": 9, "angle": 30}],
                "3": [{"op": "defocus_blur", "radius": 3.0}, {"op": "motion_blur", "length": 13, "angle": 120}],
                "4": [{"op": "defocus_blur", "radius": 4.0}, {"op": "motion_blur", "length": 19, "angle": 120}]}},

    {"type": "jpeg", "category": "compression", "tier": "core", "order": "JPEG compression",
     "description": "JPEG compression only (4:2:0, OpenCV / libjpeg)",
     "levels": {"1": [{"op": "jpeg", "quality": 60}], "2": [{"op": "jpeg", "quality": 40}],
                "3": [{"op": "jpeg", "quality": 20}], "4": [{"op": "jpeg", "quality": 10}]}},

    {"type": "gaussian_noise", "category": "noise", "tier": "core", "order": "Gaussian noise",
     "description": "additive white Gaussian noise, independent per channel (sigma on the 0-255 scale)",
     "levels": {"1": [{"op": "gaussian_noise", "sigma": 4}], "2": [{"op": "gaussian_noise", "sigma": 8}],
                "3": [{"op": "gaussian_noise", "sigma": 15}], "4": [{"op": "gaussian_noise", "sigma": 25}]}},

    {"type": "sensor_noise", "category": "noise", "tier": "core", "order": "Sensor noise (Poisson shot noise + Gaussian read noise)",
     "description": "sensor-like signal-dependent noise in linear light: fewer electrons at white (full_well) = higher ISO",
     "levels": {"1": [{"op": "poisson_gaussian_noise", "full_well": 2000, "read_sigma": 0.002}],
                "2": [{"op": "poisson_gaussian_noise", "full_well": 700, "read_sigma": 0.004}],
                "3": [{"op": "poisson_gaussian_noise", "full_well": 250, "read_sigma": 0.008}],
                "4": [{"op": "poisson_gaussian_noise", "full_well": 90, "read_sigma": 0.014}]}},

    {"type": "low_light", "category": "low_light", "tier": "core", "order": "Underexposure -> Sensor noise -> Contrast reduction",
     "description": "low light: less light reaches the sensor, the noise of a short / high-gain exposure, flatter contrast",
     "levels": {"1": [{"op": "exposure", "gain": 0.55}, {"op": "poisson_gaussian_noise", "full_well": 1200, "read_sigma": 0.002}, {"op": "contrast", "factor": 0.95}],
                "2": [{"op": "exposure", "gain": 0.32}, {"op": "poisson_gaussian_noise", "full_well": 600, "read_sigma": 0.003}, {"op": "contrast", "factor": 0.9}],
                "3": [{"op": "exposure", "gain": 0.18}, {"op": "poisson_gaussian_noise", "full_well": 300, "read_sigma": 0.004}, {"op": "contrast", "factor": 0.85}],
                "4": [{"op": "exposure", "gain": 0.10}, {"op": "poisson_gaussian_noise", "full_well": 150, "read_sigma": 0.005}, {"op": "contrast", "factor": 0.8}]}},

    {"type": "underexposure", "category": "photometric", "tier": "core", "order": "Exposure reduction",
     "description": "mild brightness loss (no added noise)",
     "levels": {"1": [{"op": "exposure", "gain": 0.7}], "2": [{"op": "exposure", "gain": 0.45}]}},
    {"type": "overexposure", "category": "photometric", "tier": "core", "order": "Exposure increase",
     "description": "mild over-exposure, highlights clip",
     "levels": {"1": [{"op": "exposure", "gain": 1.35}], "2": [{"op": "exposure", "gain": 1.8}]}},
    {"type": "low_contrast", "category": "photometric", "tier": "core", "order": "Contrast reduction",
     "description": "flat contrast (haze, backlight)",
     "levels": {"1": [{"op": "contrast", "factor": 0.75}], "2": [{"op": "contrast", "factor": 0.5}]}},
    {"type": "color_shift", "category": "photometric", "tier": "core", "order": "White-balance shift -> Desaturation",
     "description": "colour degradation: level 1 warm cast, level 2 stronger cool cast, both slightly desaturated",
     "levels": {"1": [{"op": "white_balance", "rgb_gain": [1.12, 1.0, 0.86]}, {"op": "saturation", "factor": 0.85}],
                "2": [{"op": "white_balance", "rgb_gain": [0.80, 0.97, 1.18]}, {"op": "saturation", "factor": 0.65}]}},

    {"type": "blur_noise", "category": "combined", "tier": "core", "order": "Gaussian blur -> Gaussian noise",
     "description": "blur + noise",
     "levels": {"1": [{"op": "gaussian_blur", "sigma": 1.2}, {"op": "gaussian_noise", "sigma": 5}],
                "2": [{"op": "gaussian_blur", "sigma": 2.0}, {"op": "gaussian_noise", "sigma": 10}],
                "3": [{"op": "gaussian_blur", "sigma": 3.0}, {"op": "gaussian_noise", "sigma": 18}]}},
    {"type": "blur_jpeg", "category": "combined", "tier": "core", "order": "Gaussian blur -> JPEG compression",
     "description": "blur + compression",
     "levels": {"1": [{"op": "gaussian_blur", "sigma": 1.2}, {"op": "jpeg", "quality": 60}],
                "2": [{"op": "gaussian_blur", "sigma": 2.0}, {"op": "jpeg", "quality": 35}],
                "3": [{"op": "gaussian_blur", "sigma": 3.0}, {"op": "jpeg", "quality": 18}]}},
    {"type": "down_jpeg", "category": "combined", "tier": "core", "order": "Downsample (area) -> Upsample (bicubic) -> JPEG compression",
     "description": "downsampling + compression (a small picture enlarged and re-saved)",
     "levels": {"1": [{"op": "resize_down", "factor": 1.5, "interp": "area"}, {"op": "resize_up", "interp": "bicubic"}, {"op": "jpeg", "quality": 60}],
                "2": [{"op": "resize_down", "factor": 2.0, "interp": "area"}, {"op": "resize_up", "interp": "bicubic"}, {"op": "jpeg", "quality": 35}],
                "3": [{"op": "resize_down", "factor": 3.0, "interp": "area"}, {"op": "resize_up", "interp": "bicubic"}, {"op": "jpeg", "quality": 18}]}},
    {"type": "motion_noise_jpeg", "category": "combined", "tier": "core", "order": "Motion blur -> Sensor noise -> JPEG compression",
     "description": "realistic capture chain: movement, sensor noise, then the camera's JPEG",
     "levels": {"1": [{"op": "motion_blur", "length": 7, "angle": 20}, {"op": "poisson_gaussian_noise", "full_well": 2000, "read_sigma": 0.002}, {"op": "jpeg", "quality": 65}],
                "2": [{"op": "motion_blur", "length": 11, "angle": 20}, {"op": "poisson_gaussian_noise", "full_well": 700, "read_sigma": 0.004}, {"op": "jpeg", "quality": 40}],
                "3": [{"op": "motion_blur", "length": 17, "angle": 20}, {"op": "poisson_gaussian_noise", "full_well": 250, "read_sigma": 0.008}, {"op": "jpeg", "quality": 22}]}},
    {"type": "down_motion_noise_jpeg", "category": "combined", "tier": "core", "order": "Downsample (area) -> Motion blur -> Sensor noise -> Upsample (bicubic) -> JPEG compression",
     "description": "low-resolution moving capture with noise, enlarged to the reference size and compressed (motion length is in pixels of the downsampled image)",
     "levels": {"1": [{"op": "resize_down", "factor": 1.5, "interp": "area"}, {"op": "motion_blur", "length": 4, "angle": 160}, {"op": "poisson_gaussian_noise", "full_well": 2000, "read_sigma": 0.002}, {"op": "resize_up", "interp": "bicubic"}, {"op": "jpeg", "quality": 65}],
                "2": [{"op": "resize_down", "factor": 2.0, "interp": "area"}, {"op": "motion_blur", "length": 6, "angle": 160}, {"op": "poisson_gaussian_noise", "full_well": 700, "read_sigma": 0.004}, {"op": "resize_up", "interp": "bicubic"}, {"op": "jpeg", "quality": 40}],
                "3": [{"op": "resize_down", "factor": 3.0, "interp": "area"}, {"op": "motion_blur", "length": 7, "angle": 160}, {"op": "poisson_gaussian_noise", "full_well": 250, "read_sigma": 0.008}, {"op": "resize_up", "interp": "bicubic"}, {"op": "jpeg", "quality": 22}]}}
  ]
}
