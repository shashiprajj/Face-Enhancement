{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fes/phase2/reference_record/1.0.0",
  "title": "Canonical clean-reference record (splits.csv.gz)",
  "description": "One row per accepted clean reference. CSV values are strings; 'type' here states the logical type.",
  "type": "object",
  "required": ["ref_id", "sample_id", "split", "role", "pool", "split_source", "source_path", "source_sha256",
               "ref_path", "ref_sha256", "ref_pixel_sha256", "ref_size", "ref_version", "crop_box_xywh",
               "det_bbox_xywh", "det_landmarks", "det_score", "detector", "preproc_version",
               "leak_flag", "leak_max_cos_to_other_role", "license", "source_url", "license_status"],
  "properties": {
    "ref_id": {"type": "string", "pattern": "^ff-(train|val)-[0-9]+\\.ref-v1$"},
    "sample_id": {"type": "string", "pattern": "^ff-(train|val)-[0-9]+$"},
    "split": {"type": "string", "enum": ["dev", "test", "excluded_leakage"]},
    "subset": {"type": "string", "enum": ["", "dev_pilot", "test_core"]},
    "role": {"type": "string", "enum": ["dev", "test"]},
    "pool": {"type": "string", "enum": ["dev_pool", "test_pool"]},
    "split_source": {"type": "string", "enum": ["train", "val"], "description": "official FairFace split of the source"},
    "race": {"type": "string", "description": "FairFace label, aggregate fairness strata only"},
    "gender": {"type": "string"},
    "age": {"type": "string"},
    "source_path": {"type": "string", "pattern": "^datasets/work/DS01_fairface/v1/(train|val)/[0-9]+\\.jpg$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref_path": {"type": "string", "pattern": "^datasets/derived/DS01_fairface/references/ref-v1/(train|val)/ff-(train|val)-[0-9]+\\.png$"},
    "ref_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref_pixel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref_size": {"type": "integer", "enum": [224]},
    "ref_version": {"type": "string", "enum": ["ref-v1"]},
    "crop_box_xywh": {"type": "json", "description": "identity crop over the full chip"},
    "det_bbox_xywh": {"type": "json"},
    "det_landmarks": {"type": "json", "description": "5x2 in source px: image-left eye, image-right eye, nose, mouth-left, mouth-right"},
    "det_score": {"type": "number"},
    "detector": {"type": "string", "pattern": "^yunet:"},
    "preproc_version": {"type": "string", "pattern": "^preproc-"},
    "ffhq512_transform_2x3": {"type": "json", "description": "similarity source→FFHQ-512 canonical frame (recorded, not applied)"},
    "leak_flag": {"type": "boolean"},
    "leak_max_cos_to_other_role": {"type": "number"},
    "license": {"type": "string", "enum": ["CC BY 4.0"]},
    "source_url": {"type": "string"},
    "license_status": {"type": "string"}
  }
}
