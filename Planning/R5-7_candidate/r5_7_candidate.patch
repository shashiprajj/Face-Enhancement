+"""R5-7 — recalibrate the NAFNet artifact guard from DEV evidence and re-seal the route config (1.0.0 → 1.1.0).
+
+    PYTHONPATH=src .venv/Scripts/python.exe scripts/r5_7_guard_calibrate.py
+
+Evidence (DEV only): data/manifests/phase5_rapid/r5_7/val_guard.csv.gz — the archive `val` split through the service's
+face_chip path with the sealed 1.0.0 gate/guard (scripts/r5_7_dev_collect.py) — and the visual labels in
+data/manifests/phase5_rapid/r5_7/visual_labels_high.json (every eligible output with chroma p99 > 20 or no face on the
+output, inspected; 15 destroyed by rainbow-block artefacts). The 10–20 band was inspected separately (all 30
+GT-chroma-flagged + 12 random outputs: no artefact) and is labelled legitimate. Not used: archive test, ztest, the
+200 real photos, any R5-6 result.
+
+Rules (fixed before the thresholds were computed):
+  chroma_p999_max = midpoint between the largest p99.9 of a legitimate output and the smallest p99.9 of a destroyed one
+  chroma_p99_max  = 0.9 × the smallest p99 of a destroyed output (backstop: alone it still blocks every DEV destruction)
+Everything else in the config (input gate, other guard rules, model asset) is copied unchanged.
+"""
+from __future__ import annotations
+
+import json
+
+from fes_bench import gate as GT
+from fes_data.common import read_csv_gz, repo_path, run_info, write_json
+from fes_service import nafnet_route as NR
+
+OUT = "data/manifests/phase5_rapid/r5_7"
+
+
+def main() -> None:
+    rows = [r for r in read_csv_gz(repo_path(f"{OUT}/val_guard.csv.gz")) if r["fc_eligible"] == "True"]
+    lab = json.loads(repo_path(f"{OUT}/visual_labels_high.json").read_text(encoding="utf-8"))
+    dest = [r for r in rows if lab.get(r["name"]) == "destructive"]
+    legit = [r for r in rows if lab.get(r["name"]) != "destructive"]
+    c99, c999 = (lambda r: float(r["fc_g_chroma_p99"])), (lambda r: float(r["fc_x_chroma_p999"]))
+    t999 = round((max(map(c999, legit)) + min(map(c999, dest))) / 2, 2)
+    t99 = round(0.9 * min(map(c99, dest)), 2)
+    old = json.loads(repo_path(NR.CONFIG).read_text(encoding="utf-8"))
+    write_json(repo_path("configs/phase5/r5_nafnet_route_v1.0.0.json"), old)          # the R5-5/R5-6 control config
+    cfg = {k: v for k, v in old.items() if k != "sha256"}
+    cfg["route_version"] = NR.ROUTE_VERSION
+    cfg["guard"] = {**old["guard"], "chroma_p99_max": t99, "chroma_p999_max": t999}
+    cfg["guard_calibration_r5_7"] = {
+        "data": "DEV only: archive val split (19,290; face_chip path) + visual labels of every eligible output with "
+                "chroma p99 > 20 or no output face; 10-20 band inspected (30 GT-flagged + 12 random: no artefact)",
+        "n_eligible": len(rows), "n_destructive_visual": len(dest),
+        "legit_p999_max": max(map(c999, legit)), "destructive_p999_min": min(map(c999, dest)),
+        "destructive_p99_min": min(map(c99, dest)),
+        "rules": {"chroma_p999_max": "midpoint(legit p99.9 max, destructive p99.9 min)",
+                  "chroma_p99_max": "0.9 x destructive p99 min (backstop)"},
+        "previous": {"route_version": old["route_version"], "sha256": old["sha256"],
+                     "chroma_p99_max": old["guard"]["chroma_p99_max"]},
+        "pre_registered_label_note": "the GT chroma-excess > 10 label (R5-ARCHIVE) flagged clean restorations in the "
+                                     "10-20 band; visual DEV labels were used instead"}
+    cfg["sha256"] = GT.gate_hash(cfg)
+    write_json(repo_path(NR.CONFIG), cfg)
+    blocked = lambda r: c99(r) > t99 or c999(r) > t999 or any(  # noqa: E731
+        x in r["fc_guard_reasons"] for x in ("FACE_INVALID", "HIGH_FREQ", "NUMERIC", "GRAY"))
+    summ = {"t99": t99, "t999": t999, "seal": cfg["sha256"],
+            "dev_blocked_old": sum(r["fc_guard_pass"] != "True" for r in rows), "dev_blocked_new": sum(map(blocked, rows)),
+            "dev_destructive_blocked_new": sum(map(blocked, dest)), "dev_destructive": len(dest),
+            "dev_destructive_caught_by_p99_alone": sum(c99(r) > t99 for r in dest),
+            "dev_destructive_caught_by_p999_alone": sum(c999(r) > t999 for r in dest)}
+    write_json(repo_path(f"{OUT}/guard_calibration.json"), run_info(summ))
+    print(json.dumps(summ, indent=1))
+
+
+if __name__ == "__main__":
+    main()
