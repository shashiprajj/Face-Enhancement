+def reflect_pad16(img: np.ndarray) -> tuple[np.ndarray, int, int]:
+    """Reflect-pad H and W (bottom/right) up to the next multiple of 16 → (padded, h, w)."""
+    import cv2
+    h, w = img.shape[:2]
