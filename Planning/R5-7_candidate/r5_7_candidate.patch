+def lab_shift(img, da=0.0, mask=None):
+    lab = cv2.cvtColor(img, cv2.COLOR_BGR2LAB).astype(np.float64)
+    if mask is None:
+        lab[..., 1] += da
+    else:
+        lab[..., 1][mask] += da
